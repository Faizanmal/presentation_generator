# =============================================================================
# FRONTEND — Vercel / local Next.js
# =============================================================================
# Local:   cp frontend/.env.example frontend/.env.local
# Vercel:  paste these into Settings → Environment Variables
#
# Single VPS: skip this file and use the repo-root .env.example instead.
# Next.js also loads ../.env when a key is missing here.
# =============================================================================

# Required
# Local:      http://localhost:3001/api
# Vercel:     https://your-api.onrender.com/api
# Single VPS: https://yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# Skip Render free-tier wake-up UI (true for local / always-on VPS)
NEXT_PUBLIC_SKIP_COLD_START=true

# Feature flags (NEXT_PUBLIC_FEATURE_* — "true" / "false"; omit = default below)
# NEXT_PUBLIC_FEATURE_EDITOR_V2=false
# NEXT_PUBLIC_FEATURE_TEAM_ANALYTICS=false
# NEXT_PUBLIC_FEATURE_TEAM_INVITES=false
# NEXT_PUBLIC_FEATURE_SELL_TEMPLATES=false
# NEXT_PUBLIC_FEATURE_HOMEPAGE_STATS=false
# NEXT_PUBLIC_FEATURE_MARKETPLACE=false
# NEXT_PUBLIC_FEATURE_LIVE_QA=false
# NEXT_PUBLIC_FEATURE_LEARNING_PATHS=false
# NEXT_PUBLIC_FEATURE_IMMERSIVE=false
# NEXT_PUBLIC_FEATURE_CROSS_SYNC=false
# NEXT_PUBLIC_FEATURE_PRESENTATION_COACH=false
# NEXT_PUBLIC_FEATURE_AI_COPILOT=false

# Optional
# NEXT_PUBLIC_COLLAB_SOCKET_URL=
# NEXT_PUBLIC_CDN_URL=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ENV=development

# Vercel server-only (not exposed to the browser)
# KEEPALIVE_BACKEND_URL=https://your-api.onrender.com
# KEEPALIVE_SECRET=

# Legacy TestMail client (optional)
REACT_APP_TESTMAIL_ENABLED=false
REACT_APP_TESTMAIL_API_KEY=
REACT_APP_TESTMAIL_NAMESPACE=presentation-designer
REACT_APP_TESTMAIL_WEBHOOK_URL=
REACT_APP_BACKEND_URL=http://localhost:3001
