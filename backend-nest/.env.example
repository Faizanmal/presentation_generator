# =============================================================================
# BACKEND — Render / local NestJS
# =============================================================================
# Local:   cp backend-nest/.env.example backend-nest/.env
# Render:  paste these into Environment (see also render.yaml)
#
# Single VPS: skip this file and use the repo-root .env.example instead.
# Nest and Prisma also load ../.env when a key is missing here.
#
# Do not put NEXT_PUBLIC_* keys here.
# =============================================================================

NODE_ENV=development
PORT=3001
DEMO_MODE=false

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
API_URL=http://localhost:3001
BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------
# Local Postgres:
DATABASE_URL=postgresql://user:password@localhost:5432/presentation_designer_db?schema=public&sslmode=disable
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/presentation_designer_db?schema=public&sslmode=disable
# Render (Neon) — set in the dashboard, do not commit. Pooled URL for the app,
# direct (no -pooler) for prisma migrate. On Neon free, keep DB_POOL_MAX at 5.
# DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DIRECT_DATABASE_URL=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change-me-to-a-long-random-secret
CSRF_SECRET=change-me-to-a-long-random-csrf-secret
JWT_EXPIRATION=7d
SEED_DEFAULT_PASSWORD=Password123!
CSRF_ENABLED=true
APP_NAME=PresentationDesigner

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY=
SAML_SP_ENTITY_ID=presentation-designer-saas
SAML_SP_ASSERTION_URL=http://localhost:3001/api/auth/saml/callback

# -----------------------------------------------------------------------------
# DATABASE POOL / SHARDING
# -----------------------------------------------------------------------------
DB_POOL_MIN=0
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=60000
DB_POOL_SIZE=50
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=10
ENABLE_DB_SHARDING=false
DB_SHARD_STRATEGY=hash
# DB_SHARD_CONFIG=[{"id":"shard_0","url":"postgresql://...","weight":1}]

POSTGRES_USER=presentation
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=presentation_designer_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=presentation_designer

# -----------------------------------------------------------------------------
# REDIS / QUEUES / CACHE / RATE LIMIT
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=
REDIS_AUTH_ENABLED=false
REDIS_LOW_LOAD=false
REDIS_TLS=false
REDIS_CLUSTER_MODE=false
REDIS_CLUSTER_NODES=
CLUSTER_REDIS_ENABLED=false

QUEUE_ENABLED=true
QUEUE_DEFAULT_CONCURRENCY=5
CACHE_DEFAULT_TTL=3600
CACHE_MAX_SIZE=1000

RATE_LIMIT_USE_REDIS=false
RATE_LIMIT_STRATEGY=sliding-window
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

AI_GENERATION_CONCURRENCY=10
THINKING_QUEUE_CONCURRENCY=5
IMAGE_GENERATION_CONCURRENCY=3
EXPORT_CONCURRENCY=8
EMAIL_CONCURRENCY=20
COLLABORATION_CONCURRENCY=50
WS_MAX_CONNECTIONS=10000

# -----------------------------------------------------------------------------
# AI PROVIDERS (leave empty to disable that provider)
